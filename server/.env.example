# Copy to .env for local runs; set the same keys in Render's dashboard for deploy.

# Web Push — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# LINE Messaging API — the alert bot is the official account @751iidqv
# (manager.line.biz/account/@751iidqv). The token below comes from that
# account's channel in the LINE Developers Console, not from the manager.
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=          # optional, but verifies the webhook signature
LINE_GROUP_ID=                # read it from the webhook log on first run

# The single shared secret the page and the API both use.
ACCESS_TOKEN=

# Optional weaker secret for the GET /api/trigger link, so a colleague can
# raise an alert without being able to register devices or post to LINE.
TRIGGER_TOKEN=

# Where the page lives, used to build the URL the notification opens.
APP_URL=https://your-site.netlify.app

# Only needed if the backend sits behind a proxy that rewrites the host.
PUBLIC_BASE_URL=

# Default text posted to the LINE group when you acknowledge.
ACK_MESSAGE=On my way.

# Supabase (optional — without these the server keeps state in memory only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
